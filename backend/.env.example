# Copy to backend/.env (local) or set in your hosting environment. Never commit real values.

# --- Django core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
# Comma-separated. Production: your API domain only, e.g. api.whatinside.example
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Optional separate JWT signing key (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Database ---
DATABASE_URL=postgres://whatinside:whatinside@localhost:5432/whatinside

# --- CORS (only needed for browser clients; the mobile app doesn't use CORS) ---
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# --- Email (password reset) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For SMTP: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and set EMAIL_URL-style vars below
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=WhatInside <no-reply@example.com>
PASSWORD_RESET_URL=whatinside://reset-password

# --- Celery / Redis (scheduled reminder dispatch) ---
CELERY_BROKER_URL=redis://localhost:6379/0
NOTIFICATION_DISPATCH_SECONDS=300

# --- Scanning ---
OCR_PROVIDER=tesseract            # tesseract | disabled
OCR_MAX_UPLOAD_BYTES=8388608
BARCODE_PROVIDER=openfoodfacts    # openfoodfacts | disabled
BARCODE_PROVIDER_URL=https://world.openfoodfacts.org/api/v2/product/{barcode}.json
BARCODE_PROVIDER_TIMEOUT=5
BARCODE_USER_AGENT=WhatInside/1.0 (you@example.com)

# --- Expo push ---
# Optional: only if you enabled "enhanced push security" in your Expo account
EXPO_ACCESS_TOKEN=

# --- Misc ---
EXPIRING_SOON_DAYS=7
LOG_LEVEL=INFO
THROTTLE_AUTH=20/min
THROTTLE_SCANNING=30/min
