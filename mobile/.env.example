# Backend base URL (no trailing slash). Examples:
#   Android emulator:   http://10.0.2.2:8000
#   iOS simulator:      http://localhost:8000
#   Physical phone:     http://192.168.1.20:8000   (your computer's LAN IP, same Wi-Fi)
#   Production:         https://api.yourdomain.com
# If unset in development, the app derives http://<metro-host>:8000 automatically.
# Production builds REFUSE to start without an https URL.
EXPO_PUBLIC_API_URL=

# From `npx eas-cli@latest init` — needed for Expo push tokens.
EAS_PROJECT_ID=
