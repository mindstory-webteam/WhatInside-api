    "react-native-svg": "^15.15.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start:go": "expo start --go",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "expo lint",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-native-ml-kit|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|lucide-react-native|react-native-svg|react-navigation|@react-navigation/.*|@tanstack/.*|i18next|react-i18next|zod|@hookform/.*))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
