# Production environment — copy to deploy/.env.prod and fill in. Never commit the real file.
API_DOMAIN=api.example.com
POSTGRES_DB=whatinside
POSTGRES_USER=whatinside
POSTGRES_PASSWORD=generate-a-long-random-password

DJANGO_SECRET_KEY=generate-with-python-secrets-token_urlsafe-64
# keep localhost: the container healthcheck uses it
DJANGO_ALLOWED_HOSTS=api.example.com,localhost
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOWED_ORIGINS=
SECURE_SSL_REDIRECT=true
# Set to false ONLY for a temporary HTTP test on a bare IP (with docker-compose.http.yml)
HTTPS_ENABLED=true
GUNICORN_WORKERS=3

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=WhatInside <no-reply@example.com>
PASSWORD_RESET_URL=whatinside://reset-password

OCR_PROVIDER=tesseract
BARCODE_PROVIDER=openfoodfacts
BARCODE_USER_AGENT=WhatInside/1.0 (ops@example.com)
EXPO_ACCESS_TOKEN=
LOG_LEVEL=INFO

# --- SMS one-time codes (mobile-number sign-up & password reset) ---------------
# console = codes only appear in `docker compose logs api` (nothing is texted)
# msg91   = MSG91 (India; needs a DLT-approved OTP template with an ##otp## variable)
# twilio  = Twilio
SMS_BACKEND=console
DEFAULT_PHONE_COUNTRY_CODE=91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_OTP_VAR=otp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TESTING ONLY — the app shows the code on screen. Turn OFF before real users.
OTP_DEBUG_RETURN_CODE=false
